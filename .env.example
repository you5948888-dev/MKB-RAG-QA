# 复制本文件为 .env 并按实际部署修改：cp .env.example .env
# .env 含真实凭据，不要提交到 Git；.env.example 作为字段清单提交。

# ── Milvus 向量数据库 ──
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_tutorial_hybrid
INDEX_QUESTION_COLLECTION=rag_tutorial_index_questions

# ── BGE Embedding 服务 ──
BGE_URL=http://localhost:9500
BGE_DENSE_DIM=1024

# ── LLM 大语言模型 ──
LLM_API_URL=http://localhost:9097/v1
LLM_MODEL_NAME=Qwen3-32B-FP8
LLM_API_KEY=replace-with-your-api-key
LLM_REQUEST_TIMEOUT=60

# ── Redis / Celery 异步任务队列 ──
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
UPLOAD_TASK_QUEUE=upload_queue

# ── 任务超时保护（秒） ──
PARSE_TIMEOUT=180
INDEX_TIMEOUT=900

# ── FastAPI 服务 ──
APP_HOST=127.0.0.1
APP_PORT=8013

# ── 安全 ──
# 占位符不能用于真实认证，config.py 会拒绝占位符并阻止启动。
AUTH_SECRET_KEY=replace-with-a-random-secret

# ── LangSmith LLM 追踪（可选，默认关闭）───────────────────
# 开启后 LLM 调用会上报到 LangSmith（查看 prompt/回复/token/流式时序）。
# 【注意】开启会把用户问题、检索上下文与回答上传到 LangSmith 云端（自托管除外）。
# 不配置或 LANGSMITH_ENABLED=false 时完全不生效：不写环境变量、不发网络请求。
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=replace-with-your-langsmith-key
LANGSMITH_PROJECT=RAG实战
LANGSMITH_TRACING_SAMPLING_RATE=1
# 自托管时改成自建地址
# LANGSMITH_ENDPOINT=http://localhost:1984
# LANGSMITH_UI_URL=http://localhost
