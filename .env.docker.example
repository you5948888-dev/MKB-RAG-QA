# 容器应用配置模板（Ch14）
# 复制为 .env.docker 后填入真实值：Copy-Item .env.docker.example .env.docker
# .env.docker 由 compose.yaml 的 env_file 注入 web / worker 两个容器。
#
# 地址填写原则：
#   - 服务跑在 Docker 宿主机上（Docker Desktop / Linux）→ 用 host.docker.internal；
#   - 服务在另一台服务器上 → 换成那台机器的内网 IP 或 DNS（本项目即是此种情况）；
#   - 容器内的 127.0.0.1 指容器自身，不能代表宿主机。
# 本文件不含密钥，可提交；.env.docker 属部署实配置，不提交、也不进镜像。

# ── Milvus 向量数据库 ──
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_tutorial_hybrid
INDEX_QUESTION_COLLECTION=rag_tutorial_index_questions

# ── BGE Embedding / Rerank 服务 ──
BGE_URL=http://host.docker.internal:9500
BGE_DENSE_DIM=1024

# ── LLM 大语言模型（OpenAI 兼容）──
LLM_API_URL=http://host.docker.internal:9097/v1
LLM_MODEL_NAME=replace-with-your-model-name
LLM_API_KEY=replace-with-your-api-key
LLM_REQUEST_TIMEOUT=60

# ── Redis / Celery：Redis 在 Compose 网络内，用服务名 ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
UPLOAD_TASK_QUEUE=upload_queue

# ── 任务超时保护（秒）──
PARSE_TIMEOUT=180
INDEX_TIMEOUT=900

# ── FastAPI 服务 ──
APP_HOST=0.0.0.0
APP_PORT=8013

# ── 安全：必须是随机值，占位符会被 config.py 拒绝并阻止启动 ──
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-random-secret
